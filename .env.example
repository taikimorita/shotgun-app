# Public Expo values only. Never put the service-role key, database password,
# or Azure client secret in this file or the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local backend (after `npx supabase start`):
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon key printed by supabase start>
